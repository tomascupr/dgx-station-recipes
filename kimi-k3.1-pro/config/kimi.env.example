# ~/.kimi-k31/config.env: uncomment only what you want to change.
# KIMI_PORT=30005                          # OpenAI endpoint port
# KIMI_HOST=127.0.0.1                      # bind address; no API key, so keep it local or put a proxy with auth in front
# KIMI_PACK_DIRS=/disk1/q2,/disk2/q2       # the packed experts (674 GiB); two directories if no disk has room
# KIMI_MODEL_DIR=/path/to/expert-free      # the checkpoint without routed experts (107 GiB)
# KIMI_NATIVE_DIR=/path/to/Kimi-K3.1-Pro   # Moonshot's checkpoint (1.45 TiB); only `kimi prepare` reads it
# KIMI_PACK_SPLIT=34                       # `kimi prepare` with two directories: the first layer that goes to the second
# KIMI_DRAFT_DIR=/path/to/DSpark-preview   # the draft model (5 GiB); KIMI_DRAFT_DIR= serves without speculation
# KIMI_MAXLEN=131072                       # maximum context length
# KIMI_MAX_SEQS=4                          # maximum concurrent sequences
