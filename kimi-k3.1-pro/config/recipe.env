# Fixed recipe constants. Change them only by editing this file and re-running `kimi verify` and `kimi gate`.
# Operator knobs are in config/kimi.env.example.
KIMI_SUPPORTED_IMAGE='vllm/vllm-openai:kimi-k31'
KIMI_RELEASE_REPO='tomcupr/Kimi-K3.1-Pro-DGX-Station-2bit'   # packed/ and model/, made by `kimi prepare` from:
KIMI_MODEL_REPO='moonshotai/Kimi-K3.1-Pro'
KIMI_MODEL_REV='d9e99b0792a5e93b78ea9bea62a68167e36ddd9e'
KIMI_DRAFT_REPO='Inferact/Kimi-K3.1-Pro-DSpark-preview'
# Per MoE layer, by usage rank (serve/rank-native.json): the 110 most used experts on the RTX, the next 200 in the
# GB300's HBM, 538 in pinned Grace memory (404 GiB), the 48 least used dropped (RESULTS.md, Placement).
KIMI_PEER=110
KIMI_PEER_FIRST=0
KIMI_HOT=200
KIMI_PRUNE=48
# Non-expert weights in FP8 (vLLM's load-time quantization), 2 draft tokens per step, 8 GiB KV cache (~142K tokens).
KIMI_QUANT='fp8_per_block'
KIMI_DRAFT_TOKENS=2
KIMI_KV_BYTES=8589934592
KIMI_UTIL=0.95
