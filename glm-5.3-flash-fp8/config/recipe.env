# Fixed recipe constants: the release ships exactly one recipe. Change them only by editing this file and re-running
# `glm53 verify`. Operator knobs are in config/glm53.env.example.
GLM53_SUPPORTED_IMAGE='vllm/vllm-openai:nightly-a2bcb5657a881a002e79d0adab3c6b5e39436121'
GLM53_IMAGE_DIGEST='sha256:bd419f1669b420e7dfcfa2545a9f3b05c2312c858a215b1f287284d7398d3367'
GLM53_MODEL_REPO='zai-org/GLM-5.3-Flash'
GLM53_MODEL_REV='46a050bec13002ad29ee795c16e61cf4fa3c4a9c'
GLM53_SHARDS=62
# 202 hot experts per layer on the GB300, 86 cold on the RTX (routing/; RESULTS.md, Expert routing).
GLM53_ROWMAP='rowmap-mix-v1-h202.json'
# The GB300 holds ~221 GiB of weights with this rowmap; small CUDA graphs and a fixed 6 GiB KV cache (~680K tokens)
# are what fit beside them (RESULTS.md, GB300 memory).
GLM53_KV_BYTES=6442450944
GLM53_UTIL=0.97
GLM53_CAPTURE_SIZES='[1,2,4,6,8,12,16,18,24,30,36,48,60,72,96,120,144,192]'
GLM53_MTP_TOKENS=5
