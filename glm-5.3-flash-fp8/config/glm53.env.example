# ~/.glm53/config.env: uncomment only what you want to change.
# GLM53_PORT=30004                        # OpenAI endpoint port
# GLM53_HOST=127.0.0.1                    # bind address; no API key, so keep it local or put a proxy with auth in front
# GLM53_MODEL_DIR=/path/to/GLM-5.3-Flash  # weights you already have (revision in config/recipe.env); install then checks them
# GLM53_MAXLEN=524288                     # maximum context length; the 6 GiB KV cache holds ~680K tokens in all
# GLM53_MAX_SEQS=32                       # maximum concurrent sequences
