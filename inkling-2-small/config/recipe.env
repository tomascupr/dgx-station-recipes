# Release pins. The launcher applies these only when the operator has not set
# the same name. Override in ~/.inkling2/config.env, not here.
INKLING2_SUPPORTED_IMAGE='vllm/vllm-openai:inkling-2-small'
INKLING2_MODEL_REPO='thinkingmachines/Inkling-2-Small'
INKLING2_MODEL_REV='8361e7a31ae7e9966a49a91d3994fde618936c2b'
INKLING2_DEFAULT_PORT='30008'
INKLING2_DEFAULT_HOST='127.0.0.1'
INKLING2_DEFAULT_SEGMENT='/dev/shm/inkling2-peer'
# 199.425 GiB is every MXFP8 expert plus 158 NVFP4 ids. 87 GiB is 130 NVFP4 ids.
INKLING2_DEFAULT_GB300_EXPERT_GIB='199.425'
INKLING2_DEFAULT_RTX_EXPERT_GIB='87'
# Device LRU for spill experts staged from Grace. The GEMM does not TMA from host.
INKLING2_SPILL_POOL_GIB='4'
# Preflight refuses a GPU whose memory.used is at or above this. A gate, not a measurement.
INKLING2_GPU_IDLE_MIB='2048'
